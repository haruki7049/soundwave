cabal-version:      3.0
name:               backend
version:            0.1.0.0
synopsis:           soundwave server: mixes uploaded sounds and streams the result
license:            NONE
build-type:         Simple

common common-options
    default-language:   Haskell2010
    default-extensions:
        OverloadedStrings
        DeriveGeneric
        ScopedTypeVariables
        TypeApplications
    ghc-options:
        -Wall
        -threaded
        -rtsopts
        -with-rtsopts=-N

executable backend
    import:           common-options
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:
        Soundwave.Audio
        Soundwave.Config
        Soundwave.Db
        Soundwave.Mixer
        Soundwave.Station
        Soundwave.Storage
    build-depends:
        base >= 4.14 && < 5,
        aeson >= 2.0,
        async,
        bytestring >= 0.11,
        filepath,
        http-types,
        minio-hs,
        sqlite-simple,
        scotty >= 0.22,
        stm,
        temporary,
        text >= 2.0,
        time,
        typed-process,
        uuid,
        vector,
        wai-extra,
        wai-middleware-static,
        shared
