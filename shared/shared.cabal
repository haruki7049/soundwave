cabal-version:      3.0
name:               shared
version:            0.1.0.0
synopsis:           API types and routes shared by the soundwave backend and frontend
license:            NONE
build-type:         Simple

common common-options
    default-language:   Haskell2010
    default-extensions:
        OverloadedStrings
        DeriveGeneric
        DerivingStrategies
        DeriveAnyClass
    ghc-options:
        -Wall

-- Built by both the native GHC (backend) and the wasm GHC (frontend),
-- so keep the dependencies to pure Haskell packages only.
library
    import:           common-options
    hs-source-dirs:   src
    exposed-modules:
        Shared.Api
    build-depends:
        base >= 4.14 && < 5,
        aeson >= 2.0,
        text,
        time
