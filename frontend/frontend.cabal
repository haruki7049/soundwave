cabal-version:      3.0
name:               frontend
version:            0.1.0.0
synopsis:           soundwave frontend: listen to the mix and see it on an oscilloscope
license:            NONE
build-type:         Simple

common common-options
    default-language:   Haskell2010
    default-extensions:
        OverloadedStrings
        LambdaCase
        CPP
    ghc-options:
        -Wall

    -- WASM backend: link as a reactor module that exports hs_start
    if arch(wasm32)
        ghc-options:
            -no-hs-main
            -optl-mexec-model=reactor
            "-optl-Wl,--export=hs_start"
        cpp-options:
            -DWASM

executable frontend
    import:           common-options
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:
        Player
    -- Talks to the browser through the wasm JavaScript FFI,
    -- so it only builds with the wasm backend (see cabal-wasm.project)
    if !arch(wasm32)
        buildable: False
    build-depends:
        base >= 4.14 && < 5,
        ghc-experimental,
        miso,
        miso-ui,
        text,
        shared
