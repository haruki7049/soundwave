cabal-version:      3.0
name:               shared
version:            0.1.0.0
synopsis:           Shared types and UI views for Miso and Scotty
license:            NONE
build-type:         Simple

common common-options
    default-language:   Haskell2010
    default-extensions:
        OverloadedStrings
        DeriveGeneric
        DerivingStrategies
        DeriveAnyClass
    ghc-options:
        -Wall

library
    import:           common-options
    hs-source-dirs:   src
    exposed-modules:
        Shared.Types
        Shared.View
    build-depends:
        base >= 4.14 && < 5,
        aeson >= 2.0,
        containers,
        text,
        miso,
        miso-ui
